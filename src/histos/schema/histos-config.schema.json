{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIAYN-creator/Histos/schema/histos-config.schema.json",
  "title": "histos.config.yaml",
  "description": "Per-vault Histos configuration: the heuristic rules that classify a card into one of the three fixed tiers, and the evals run on propose. See docs/canvas-schema.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tiers"],
  "properties": {
    "tiers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/tier" }
    },
    "evals": { "$ref": "#/$defs/evals" },
    "critical_path": {
      "description": "The critical path drawn on the canvas arrows (v3.2). Optional: without it, it's on, magenta, and uses the active review time.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "review": { "enum": ["active", "calendar"], "description": "Which review clock counts: active (minus the human's pauses) or calendar." }
      }
    },
    "terms": {
      "description": "Extra terms for the *_terms_present / file_operations_mentioned conditions -- added to the built-in lists, never replacing them.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architecture": { "$ref": "#/$defs/termList" },
        "debugging": { "$ref": "#/$defs/termList" },
        "file_operations": { "$ref": "#/$defs/termList" }
      }
    }
  },
  "$defs": {
    "termList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "heuristics"],
      "properties": {
        "name": { "enum": ["fast", "exec", "reasoning"] },
        "match": { "enum": ["all", "any"] },
        "heuristics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 },
        "run_on": { "enum": ["propose"] }
      }
    }
  }
}
