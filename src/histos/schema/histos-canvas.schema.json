{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIAYN-creator/Histos/blob/main/src/histos/schema/histos-canvas.schema.json",
  "title": "Histos canvas",
  "description": "JSON Canvas 1.0 (https://jsoncanvas.org) restricted to Histos's conventions. It doesn't check that edges point to existing nodes, nor that the dependency graph is acyclic -- the CLI does. See docs/canvas-schema.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" },
      "default": []
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" },
      "default": []
    }
  },
  "$defs": {
    "statusColor": {
      "description": "Histos status legend: 1=Blocked, 2=In progress, 3=Proposal pending review, 4=Approved, 5=Dependency change request, 6=Backlog.",
      "type": "string",
      "enum": ["1", "2", "3", "4", "5", "6"]
    },
    "canvasColor": {
      "description": "Native JSON Canvas color (hex or preset 1-6), with no Histos meaning. Only used in group.color and edge.color.",
      "type": "string",
      "pattern": "^(#[0-9A-Fa-f]{6}|[1-6])$"
    },
    "side": {
      "type": "string",
      "enum": ["top", "right", "bottom", "left"]
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/cardNode" },
        { "$ref": "#/$defs/groupNode" },
        { "$ref": "#/$defs/textNode" }
      ]
    },
    "cardNode": {
      "description": "A task card. Points to a real .md file in content/ -- never holds embedded text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "x", "y", "width", "height", "file", "color"],
      "properties": {
        "id": {
          "description": "Stable slug, the same as the file name without its extension (id 'cap3' -> content/cap3.md).",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "type": { "const": "file" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "exclusiveMinimum": 0 },
        "height": { "type": "integer", "exclusiveMinimum": 0 },
        "file": {
          "description": "A file directly in content/. No '/', '\\' or ':' in the name: on Windows a backslash is a path separator too, and 'content/..\\..\\x.md' would point outside the vault.",
          "type": "string",
          "pattern": "^content/[^/\\\\:]+\\.md$"
        },
        "subpath": {
          "description": "Optional reference to a heading inside the .md.",
          "type": "string",
          "pattern": "^#"
        },
        "color": { "$ref": "#/$defs/statusColor" }
      }
    },
    "groupNode": {
      "description": "A purely geometric grouping (e.g. a chapter). A node 'belongs' to a group if its coordinates fall inside the group's rectangle -- there's no parent_id in the data. Carries no status.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "x", "y", "width", "height"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "group" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "exclusiveMinimum": 0 },
        "height": { "type": "integer", "exclusiveMinimum": 0 },
        "label": { "type": "string" },
        "background": { "type": "string" },
        "backgroundStyle": { "type": "string", "enum": ["cover", "ratio", "repeat"] },
        "color": { "$ref": "#/$defs/canvasColor" }
      }
    },
    "textNode": {
      "description": "Decorative/documentation text (e.g. the color legend 'histos init' puts on every new canvas). Not a card: the CLI ignores it entirely, all status/dependency logic filters on type=='file'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "x", "y", "width", "height", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "text" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "exclusiveMinimum": 0 },
        "height": { "type": "integer", "exclusiveMinimum": 0 },
        "text": { "type": "string" },
        "color": { "$ref": "#/$defs/canvasColor" }
      }
    },
    "edge": {
      "description": "fromNode -> toNode means 'toNode depends on fromNode'. fromNode must be Approved (color 4) before toNode can leave Blocked.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromNode", "toNode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fromNode": { "type": "string", "minLength": 1 },
        "toNode": { "type": "string", "minLength": 1 },
        "fromSide": { "$ref": "#/$defs/side" },
        "toSide": { "$ref": "#/$defs/side" },
        "fromEnd": { "type": "string", "enum": ["none", "arrow"], "default": "none" },
        "toEnd": { "type": "string", "enum": ["none", "arrow"], "default": "arrow" },
        "color": { "$ref": "#/$defs/canvasColor" },
        "label": { "type": "string" }
      }
    }
  }
}
